<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <!-- Stilregeln aus der .editorconfig im Wurzelverzeichnis als Warnungen im Build melden. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Namespaces tragen NC2 als Firma vorn, Projekt- und Assembly-Namen bleiben ohne. -->
    <RootNamespace>NC2.$(MSBuildProjectName)</RootNamespace>
    <Product>InputFusion</Product>
    <Version>0.12.0</Version>
  </PropertyGroup>

  <!--
    Build-Ausgaben nicht neben den Quellcode, sondern gesammelt nach _out\ parallel zu source\.
    Je Projekt ein eigener Ordner (_out\InputFusion.Host\ …), ohne Configuration- und
    TargetFramework-Unterordner. Die Zwischendateien (obj\) bleiben beim Projekt.
    Diese Datei liegt in source\, daher führt ..\ eine Ebene höher ins Wurzelverzeichnis.
  -->
  <PropertyGroup>
    <BaseOutputPath Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">$(MSBuildThisFileDirectory)..\_out\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- WPF erzeugt beim Bauen ein temporäres Projekt (…_wpftmp). Dessen Wegwerf-Ausgabe
         sammelt sich unter _out\_wpftmp\, damit die oberste Ebene nur echte Projekte zeigt. -->
    <BaseOutputPath Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">$(MSBuildThisFileDirectory)..\_out\_wpftmp\$(MSBuildProjectName)\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>

</Project>
