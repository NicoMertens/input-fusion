<Window x:Class="InputFusion.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputFusion – Einstellungen" Width="860" Height="600" MinWidth="560" MinHeight="420"
        Icon="pack://application:,,,/InputFusion.ico" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="2,0,0,8" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TabControl x:Name="Tabs">
            <TabItem Header="Verbindung">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PC-Name" Margin="0,4,16,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MachineName" IsReadOnly="True" BorderThickness="0"
                             FontSize="14" Margin="0,4,0,8" />

                    <TextBlock Grid.Row="1" Text="IP-Adressen" Margin="0,4,16,8" VerticalAlignment="Top" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="Addresses" IsReadOnly="True" BorderThickness="0"
                             FontSize="14" Margin="0,4,0,8" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Text="Port" Margin="0,4,16,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="Port" IsReadOnly="True" BorderThickness="0"
                             FontSize="14" Margin="0,4,0,8" />

                    <TextBlock Grid.Row="3" Text="Schlüssel" Margin="0,10,16,4" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,4">
                        <Button x:Name="ApplyKey" DockPanel.Dock="Right" Content="Übernehmen" Padding="12,3" Margin="6,0,0,0"
                                Click="OnApplyKey" IsEnabled="False" />
                        <Button DockPanel.Dock="Right" Content="Kopieren" Padding="12,3" Margin="6,0,0,0" Click="OnCopyKey" />
                        <Button DockPanel.Dock="Right" Content="Neu erzeugen" Padding="12,3" Margin="6,0,0,0" Click="OnGenerateKey" />
                        <TextBox x:Name="Key" FontFamily="Consolas" FontSize="15" Padding="4,3" TextChanged="OnKeyChanged" />
                    </DockPanel>

                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="KeyMessage" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource HintBrush}" />

                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource HintBrush}">
                        Auf dem Notebook PC-Name (oder IP) und Schlüssel eintragen: beim Installieren mit
                        <Run FontFamily="Consolas">install-client.ps1 -HostName … -Key …</Run>, sonst in
                        <Run FontFamily="Consolas">%ProgramData%\InputFusion\client.json</Run>.
                        Ein geänderter Schlüssel gilt ab der nächsten Verbindung.
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="ClientInfo" Margin="0,24,0,0" FontSize="14"
                               VerticalAlignment="Top" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="Anordnung">
                <DockPanel Margin="12">
                    <TextBlock x:Name="LayoutHint" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="LayoutMessage" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource HintBrush}" />
                    <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="#F6F6F6">
                        <Viewbox Stretch="Uniform" Margin="16">
                            <Canvas x:Name="Arrangement" Background="Transparent"
                                    MouseMove="OnArrangementMouseMove" MouseLeftButtonUp="OnArrangementMouseUp"
                                    LostMouseCapture="OnArrangementLostCapture" />
                        </Viewbox>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
