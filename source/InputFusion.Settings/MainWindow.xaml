<Window x:Class="InputFusion.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputFusion – Einstellungen" Width="860" Height="600" MinWidth="560" MinHeight="420"
        Icon="pack://application:,,,/InputFusion.Host.ico" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="2,0,0,8" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TabControl x:Name="Tabs">
            <TabItem Header="Verbindung">
                <Grid Margin="16">
                    <Grid.Resources>
                        <Style x:Key="IconButton" TargetType="ButtonBase">
                            <Setter Property="DockPanel.Dock" Value="Right" />
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PC-Name" Margin="0,4,16,8" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MachineName" IsReadOnly="True" BorderThickness="0"
                             FontSize="14" Margin="0,4,0,8" />

                    <TextBlock Grid.Row="1" Text="IP-Adressen" Margin="0,4,16,8" VerticalAlignment="Top" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="Addresses" IsReadOnly="True" BorderThickness="0"
                             FontSize="14" Margin="0,4,0,8" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Text="Port (TCP)" Margin="0,4,16,4" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBox x:Name="Port" Width="90" FontSize="14" Padding="4,3" TextChanged="OnPortChanged" />
                        <Button x:Name="ApplyPort" Style="{StaticResource IconButton}" Content="&#xE73E;"
                                ToolTip="Port übernehmen" Click="OnApplyPort" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PortMessage" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource HintBrush}" />

                    <TextBlock Grid.Row="4" Text="Schlüssel" Margin="0,10,16,4" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,4">
                        <Button x:Name="ApplyKey" Style="{StaticResource IconButton}" Content="&#xE73E;"
                                ToolTip="Schlüssel übernehmen" Click="OnApplyKey" IsEnabled="False" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                ToolTip="In die Zwischenablage kopieren" Click="OnCopyKey" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Neuen Schlüssel erzeugen" Click="OnGenerateKey" />
                        <ToggleButton x:Name="ShowKey" Style="{StaticResource IconButton}" Content="&#xE7B3;"
                                      ToolTip="Schlüssel anzeigen" Click="OnShowKey" />
                        <Grid x:Name="KeyField">
                            <TextBox x:Name="Key" FontFamily="Consolas" FontSize="15" Padding="4,3" TextChanged="OnKeyChanged"
                                     Visibility="Collapsed" />
                            <PasswordBox x:Name="HiddenKey" FontFamily="Consolas" FontSize="15" Padding="4,3"
                                         PasswordChanged="OnHiddenKeyChanged" />
                        </Grid>
                    </DockPanel>

                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="KeyMessage" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource HintBrush}" />

                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource HintBrush}">
                        Auf dem Notebook PC-Name (oder IP), Port und Schlüssel eintragen: beim Installieren im Setup, danach
                        in dessen Einstellungen (Tray-Symbol, als Administrator).
                        Ein geänderter Port oder Schlüssel gilt ab der nächsten Verbindung.
                    </TextBlock>

                    <Border Grid.Row="7" Grid.ColumnSpan="2" x:Name="ClientCard" Margin="0,24,0,0" Padding="16,12"
                            MinWidth="380" HorizontalAlignment="Left" VerticalAlignment="Top"
                            CornerRadius="6" BorderThickness="1">
                        <DockPanel>
                            <TextBlock x:Name="ClientIcon" DockPanel.Dock="Left" Text="&#xE7F8;" FontSize="34"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,16,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ClientDot" Width="10" Height="10" Margin="0,1,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ClientTitle" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid x:Name="ClientDetails" Margin="18,6,0,0" TextElement.FontSize="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Anordnung">
                <DockPanel Margin="12">
                    <TextBlock x:Name="LayoutHint" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="LayoutMessage" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource HintBrush}" />
                    <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="#F6F6F6" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" Margin="16">
                            <Canvas x:Name="Arrangement" Background="Transparent"
                                    MouseMove="OnArrangementMouseMove" MouseLeftButtonUp="OnArrangementMouseUp"
                                    LostMouseCapture="OnArrangementLostCapture" />
                        </Viewbox>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
