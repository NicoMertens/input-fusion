<UserControl x:Class="InputFusion.Settings.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" TextElement.FontSize="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Verbindung" Margin="0,2,16,2" Foreground="{StaticResource HintBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Connection" Margin="0,2" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="Laufzeit" Margin="0,2,16,2" Foreground="{StaticResource HintBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RoundTrip" Margin="0,2" TextWrapping="Wrap"
                       ToolTip="Ein Heartbeat hin und zurück, gemessen jede Sekunde" />

            <TextBlock Grid.Row="2" Text="Nachrichten" Margin="0,2,16,2" Foreground="{StaticResource HintBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Rates" Margin="0,2" TextWrapping="Wrap"
                       ToolTip="Pro Sekunde, Heartbeats eingeschlossen; in Klammern seit dem Verbinden" />

            <TextBlock Grid.Row="3" Text="Letzte Störung" Margin="0,2,16,2" Foreground="{StaticResource HintBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastError" Margin="0,2" TextWrapping="Wrap" />
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,6">
            <Button x:Name="OpenLog" DockPanel.Dock="Right" Padding="12,3" Click="OnOpenLog" />
            <TextBlock Text="Letzte Meldungen" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="LogHint" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource HintBrush}" />

        <TextBox x:Name="LogLines" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
