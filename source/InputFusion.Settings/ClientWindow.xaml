<Window x:Class="InputFusion.Settings.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InputFusion.Settings"
        Title="InputFusion – Einstellungen (Notebook)" Width="640" Height="580" MinWidth="480" MinHeight="500"
        Icon="pack://application:,,,/InputFusion.Client.ico" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Margin="2,0,0,8" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TabControl>
            <TabItem Header="Verbindung">
                    <Grid x:Name="Form" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PC-Name des Hosts" Margin="0,4,16,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostName" FontSize="14" Padding="4,3" Margin="0,4,0,8"
                                 TextChanged="OnInputChanged" />

                        <TextBlock Grid.Row="1" Text="Feste IP, optional" Margin="0,4,16,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="Ip" FontSize="14" Padding="4,3" Margin="0,4,0,8"
                                 TextChanged="OnInputChanged" />

                        <TextBlock Grid.Row="2" Text="Port" Margin="0,4,16,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Port" FontSize="14" Padding="4,3" Margin="0,4,0,8" Width="100"
                                 HorizontalAlignment="Left" TextChanged="OnInputChanged" />

                        <TextBlock Grid.Row="3" Text="Schlüssel" Margin="0,4,16,8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="Key" FontFamily="Consolas" FontSize="15" Padding="4,3" Margin="0,4,0,8"
                                 TextChanged="OnInputChanged" />

                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Message" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{StaticResource HintBrush}" />

                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="Apply" Content="Übernehmen" Padding="12,3" Click="OnApply" IsEnabled="False" />
                            <Button x:Name="Elevate" Content="Als Administrator bearbeiten …" Padding="12,3" Click="OnElevate" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource HintBrush}">
                            PC-Name, IP-Adressen, Port und Schlüssel stehen auf dem PC in dessen Einstellungen, Reiter Verbindung.
                            Ändern dürfen nur Administratoren; eine Änderung gilt sofort, der Client verbindet neu.
                        </TextBlock>

                        <local:ConnectionCard Grid.Row="7" Grid.ColumnSpan="2" x:Name="HostCard" Margin="0,24,0,0"
                                              Glyph="&#xE7F4;" />
                    </Grid>
            </TabItem>

            <TabItem Header="Monitore">
                <DockPanel Margin="12">
                    <TextBlock x:Name="MonitorsHint" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="#F6F6F6" ClipToBounds="True">
                        <Viewbox Stretch="Uniform" Margin="16">
                            <Canvas x:Name="Monitors" />
                        </Viewbox>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
