<Window x:Class="InputFusion.Settings.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InputFusion.Settings"
        Title="InputFusion – Einstellungen (Notebook)" Width="900" Height="660" MinWidth="680" MinHeight="480"
        Icon="pack://application:,,,/InputFusion.Client.ico" WindowStartupLocation="CenterScreen">
    <TabControl Style="{StaticResource NavTabControl}">
        <TabControl.Tag>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/InputFusion.Client.ico" Width="28" Height="28" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="InputFusion" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Einstellungen des Notebooks" Style="{StaticResource Hint}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="Status" Margin="0,14,0,0" Style="{StaticResource Hint}" FontSize="12" />
            </StackPanel>
        </TabControl.Tag>

        <TabItem Header="Verbindung" Tag="&#xE839;">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,24">
                    <TextBlock Text="Verbindung" Style="{StaticResource PageTitle}" />

                    <local:ConnectionCard x:Name="HostCard" Glyph="&#xE7F4;" Margin="0,0,0,12" />

                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="Form">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="2" Text="PC, mit dem sich das Notebook verbindet" Style="{StaticResource CardTitle}" />

                            <TextBlock Grid.Row="1" Text="PC-Name des Hosts" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostName" FontSize="14" Margin="0,4,0,8"
                                     TextChanged="OnInputChanged" />

                            <TextBlock Grid.Row="2" Text="Feste IP, optional" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Ip" FontSize="14" Margin="0,4,0,8"
                                     TextChanged="OnInputChanged" />

                            <TextBlock Grid.Row="3" Text="Port" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="Port" FontSize="14" Margin="0,4,0,8" Width="110"
                                     HorizontalAlignment="Left" TextChanged="OnInputChanged" />

                            <TextBlock Grid.Row="4" Text="Schlüssel" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="Key" FontFamily="Consolas" FontSize="15" Margin="0,4,0,8"
                                     TextChanged="OnInputChanged" />

                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="Message" Margin="0,0,0,10" Style="{StaticResource Hint}" />

                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="Apply" Content="Übernehmen" Click="OnApply" IsEnabled="False" MinWidth="120"
                                        Style="{DynamicResource AccentButtonStyle}" />
                                <Button x:Name="Elevate" Content="Als Administrator bearbeiten …" Click="OnElevate" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="4,4,4,0" Style="{StaticResource Hint}">
                        PC-Name, IP-Adressen, Port und Schlüssel stehen auf dem PC in dessen Einstellungen, Seite Verbindung.
                        Ändern dürfen nur Administratoren; eine Änderung gilt sofort, der Client verbindet neu.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Monitore" Tag="&#xE7F4;">
            <DockPanel Margin="32,24,32,24">
                <TextBlock DockPanel.Dock="Top" Text="Monitore" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="MonitorsHint" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Hint}" />
                <Border Style="{StaticResource Card}" Padding="0" Margin="0" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" Margin="16">
                        <Canvas x:Name="Monitors" />
                    </Viewbox>
                </Border>
            </DockPanel>
        </TabItem>

        <TabItem Header="Diagnose" Tag="&#xE9D9;">
            <local:DiagnosticsPanel x:Name="Diagnostics" />
        </TabItem>
    </TabControl>
</Window>
