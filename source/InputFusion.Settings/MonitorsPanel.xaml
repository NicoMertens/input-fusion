<UserControl x:Class="NC2.InputFusion.Settings.MonitorsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel Margin="32,24,32,24">
        <TextBlock DockPanel.Dock="Top" Text="Monitore" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="MonitorsHint" DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource Card}" Padding="0" Margin="0" ClipToBounds="True">
            <Viewbox Stretch="Uniform" Margin="16">
                <Canvas x:Name="Monitors" />
            </Viewbox>
        </Border>
    </DockPanel>
</UserControl>
