<UserControl x:Class="NC2.InputFusion.Settings.ClientConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NC2.InputFusion.Settings"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,24">
            <TextBlock Text="Verbindung" Style="{StaticResource PageTitle}" />

            <local:ConnectionCard x:Name="HostCard" Glyph="&#xE7F4;" Margin="0,0,0,12" />

            <Border Style="{StaticResource Card}">
                <Grid x:Name="Form">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="PCs, mit denen sich das Notebook verbindet" Style="{StaticResource CardTitle}" />

                    <TextBlock Grid.Row="1" Text="Eingetragen" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,24,8" />
                    <ListBox Grid.Row="1" Grid.Column="1" x:Name="HostList" MinHeight="64" MaxHeight="180" Margin="0,4,0,8"
                             SelectionChanged="OnHostSelected" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="AddHost" Content="PC hinzufügen" Click="OnAddHost" MinWidth="120" />
                        <Button x:Name="RemoveHost" Content="Entfernen" Click="OnRemoveHost" Margin="8,0,0,0" MinWidth="100" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="PC-Name des Hosts" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="HostName" FontSize="14" Margin="0,4,0,8"
                             TextChanged="OnInputChanged" />

                    <TextBlock Grid.Row="4" Text="Feste IP, optional" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="Ip" FontSize="14" Margin="0,4,0,8"
                             TextChanged="OnInputChanged" />

                    <TextBlock Grid.Row="5" Text="Port" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="Port" FontSize="14" Margin="0,4,0,8" Width="110"
                             HorizontalAlignment="Left" TextChanged="OnInputChanged" />

                    <TextBlock Grid.Row="6" Text="Schlüssel" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="Key" FontFamily="Consolas" FontSize="15" Margin="0,4,0,8"
                             TextChanged="OnInputChanged" />

                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="Message" Margin="0,0,0,10" Style="{StaticResource Hint}" />

                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="Apply" Content="Übernehmen" Click="OnApply" IsEnabled="False" MinWidth="120"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="Elevate" Content="Als Administrator bearbeiten …" Click="OnElevate" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="4,4,4,0" Style="{StaticResource Hint}">
                PC-Name, IP-Adressen, Port und Schlüssel stehen auf dem PC in dessen Einstellungen, Seite Verbindung.
                Mehrere PCs, etwa zu Hause und im Büro: Das Notebook versucht alle und verbindet sich mit dem, der
                gerade erreichbar ist. Ändern dürfen nur Administratoren; eine Änderung gilt sofort, der Client verbindet neu.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
