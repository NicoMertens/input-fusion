<Application x:Class="InputFusion.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <SolidColorBrush x:Key="HostMonitorBrush" Color="#2D2D30" />
        <SolidColorBrush x:Key="HostMonitorBorderBrush" Color="#9A9AA0" />
        <SolidColorBrush x:Key="ClientMonitorBrush" Color="#1E5A80" />
        <SolidColorBrush x:Key="ClientMonitorBorderBrush" Color="#4FC1FF" />
        <SolidColorBrush x:Key="TransitionBrush" Color="#FFB86C" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="HintBrush" Color="#606060" />
        <SolidColorBrush x:Key="ConnectedBrush" Color="#2E9E44" />
        <SolidColorBrush x:Key="ConnectedCardBrush" Color="#EEF7EF" />
        <SolidColorBrush x:Key="ConnectedCardBorderBrush" Color="#9FD3A8" />
        <SolidColorBrush x:Key="IdleBrush" Color="#9A9AA0" />
        <SolidColorBrush x:Key="IdleCardBrush" Color="#F6F6F6" />
        <SolidColorBrush x:Key="IdleCardBorderBrush" Color="#C8C8C8" />
    </Application.Resources>
</Application>
