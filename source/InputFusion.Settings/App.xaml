<Application x:Class="NC2.InputFusion.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup" ThemeMode="System">
    <!-- Farben für Text, Karten und Status kommen aus dem Fluent-Theme (DynamicResource), damit Hell und Dunkel der
         Windows-Einstellung folgen. Eigene Farben nur für die Monitore, die in beiden Modi gleich aussehen. -->
    <Application.Resources>
        <SolidColorBrush x:Key="HostMonitorBrush" Color="#2D2D30" />
        <SolidColorBrush x:Key="HostMonitorBorderBrush" Color="#9A9AA0" />
        <SolidColorBrush x:Key="ClientMonitorBrush" Color="#1E5A80" />
        <SolidColorBrush x:Key="ClientMonitorBorderBrush" Color="#4FC1FF" />
        <SolidColorBrush x:Key="TransitionBrush" Color="#FFB86C" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Navigation links wie in den Windows-Einstellungen: Symbol aus Tag, Text aus Header, Akzentstrich am gewählten Eintrag. -->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Background" Background="Transparent" CornerRadius="4" Padding="12,9" Margin="0,1">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Visibility="Hidden"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Width="20" Margin="2,0,12,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Links Kopf (aus Tag) und Navigation, rechts die gewählte Seite auf einer abgesetzten Fläche. -->
        <Style x:Key="NavTabControl" TargetType="TabControl">
            <!-- Der TabControl erbt sonst die schwarze Systemfarbe für Text, auch im dunklen Modus; Kopf und Seiten erben von hier. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="8,4,8,12">
                                <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Tag}" Margin="12,8,8,20"
                                                  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <StackPanel IsItemsHost="True" />
                            </DockPanel>
                            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Beschriftung vor einem Eingabefeld; ausdrücklich in der Textfarbe des Themes, geerbt kommt sie nicht zuverlässig an. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,24,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Schaltflächen nur mit Symbol. Je Typ auf dem Stil des Themes aufgebaut, ein eigener Stil ersetzte ihn sonst. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="0" />
            <!-- So hoch wie das Eingabefeld daneben; ohne Innenabstand wäre die Schaltfläche sonst niedriger. -->
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="0" />
            <!-- So hoch wie das Eingabefeld daneben; ohne Innenabstand wäre die Schaltfläche sonst niedriger. -->
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Application.Resources>
</Application>
