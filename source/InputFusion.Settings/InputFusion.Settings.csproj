<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <!-- Die exe trägt das Symbol des Hosts (Startmenü des PCs), jedes Fenster setzt das seiner Seite. -->
    <ApplicationIcon>..\InputFusion.Host.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\InputFusion.Host.ico" Link="InputFusion.Host.ico" />
    <Resource Include="..\InputFusion.Client.ico" Link="InputFusion.Client.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InputFusion.Core\InputFusion.Core.csproj" />
  </ItemGroup>

</Project>
