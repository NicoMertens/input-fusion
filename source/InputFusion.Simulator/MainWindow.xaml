<Window x:Class="InputFusion.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputFusion Simulator" Width="1200" Height="720" Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#3C3C3C" BorderThickness="1" Margin="0,0,12,0">
            <Viewbox Stretch="Uniform" Margin="12">
                <Canvas x:Name="Desktop" />
            </Viewbox>
        </Border>

        <DockPanel Grid.Column="1">
            <TextBlock x:Name="Status" DockPanel.Dock="Top" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Details" DockPanel.Dock="Top" Foreground="#A0A0A0" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Text="Gedrückt" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBlock x:Name="Pressed" DockPanel.Dock="Top" Foreground="#FFB86C" TextWrapping="Wrap" MinHeight="20" />
            <TextBlock DockPanel.Dock="Top" Text="Ereignisse" Foreground="#E0E0E0" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ListBox x:Name="Log" Background="#252526" Foreground="#D4D4D4" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
