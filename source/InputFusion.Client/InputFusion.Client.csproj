<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <!-- Das Tray-Symbol lädt das ApplicationIcon aus der exe. -->
    <ApplicationIcon>..\InputFusion.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InputFusion.Core\InputFusion.Core.csproj" />
  </ItemGroup>

  <!-- Der Release übergibt die als einzelne Datei veröffentlichten Einstellungen (-p:EmbeddedSettings=…); der
       installierte Dienst packt sie aus (SettingsExtractor). Lokale Builds kommen ohne aus. -->
  <ItemGroup Condition="'$(EmbeddedSettings)' != ''">
    <EmbeddedResource Include="$(EmbeddedSettings)" LogicalName="InputFusion.Settings.exe" />
  </ItemGroup>

</Project>
